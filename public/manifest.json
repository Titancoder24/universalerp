{
  "name": "Universal ERP",
  "short_name": "Universal ERP",
  "description": "The complete business management platform — CRM, accounting, HR, inventory, manufacturing, and more.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#6366f1",
  "categories": ["business", "productivity", "finance"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Dashboard", "url": "/app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New Invoice", "url": "/app/sales/invoices/new", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Customers", "url": "/app/sales/customers", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Chat", "url": "/app/chat", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/app/inbox/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "attachments", "accept": ["image/*", "application/pdf", "text/*"] }]
    }
  },
  "protocol_handlers": [
    { "protocol": "web+universalerp", "url": "/app/handler?url=%s" }
  ],
  "screenshots": [
    { "src": "/screenshots/dashboard.png", "sizes": "1920x1080", "form_factor": "wide" },
    { "src": "/screenshots/dashboard-mobile.png", "sizes": "1080x1920", "form_factor": "narrow" }
  ],
  "prefer_related_applications": false
}
