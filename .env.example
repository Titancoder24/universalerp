# ============================================================================
# Universal ERP - Environment Configuration
# ============================================================================
# Two ways to connect: managed Supabase OR self-hosted PostgreSQL.
# Pick one mode and fill in those vars; leave the others empty.

# ----- Mode: Supabase (recommended for quick start) -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----- Mode: Self-hosted PostgreSQL -----------------------------------------
# DATABASE_URL=postgresql://user:pass@localhost:5432/universalerp
# DIRECT_URL=postgresql://user:pass@localhost:5432/universalerp

# ----- Platform configuration ----------------------------------------------
NEXT_PUBLIC_APP_NAME=Universal ERP
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEPLOYMENT_MODE=cloud
# `cloud` (multi-tenant SaaS) | `self-hosted` (single-tenant)

# ----- Security ------------------------------------------------------------
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
ENCRYPTION_KEY=change-me-base64-32-bytes

# ----- AI (OpenRouter, optional) -------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-haiku-4-5
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# ----- File storage (Supabase Storage is default; S3 optional) -------------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ----- Realtime (mediasoup SFU for calls, optional) ------------------------
NEXT_PUBLIC_SFU_URL=
SFU_LISTEN_IP=0.0.0.0
SFU_ANNOUNCED_IP=

# ----- Localization --------------------------------------------------------
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_DEFAULT_TIMEZONE=UTC
